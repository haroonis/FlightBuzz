{
  "name": "flightbuzz",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-airport, multi-stop, stopover-aware flight price finder and tracker",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev -w @flightbuzz/server\" \"npm:dev -w @flightbuzz/web\"",
    "build": "npm run build -w @flightbuzz/web",
    "start": "npm run start -w @flightbuzz/server",
    "searches": "npm run searches -w @flightbuzz/server --",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p apps/server && tsc -p apps/web",
    "data:airports": "tsx scripts/build-airports.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.0"
  },
  "engines": { "node": ">=22.5" }
}
