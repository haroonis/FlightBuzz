# Copy to .env (or export) to configure the server. All optional.

PORT=8787
HOST=127.0.0.1
# DB_PATH=./flightbuzz.db

# Refresh saved searches at these local times (in TZ).
SCHEDULE=07:00,19:00
TZ=Europe/London

# Providers to use. Empty = Google Flights only (Kiwi and Skyscanner are opt-in).
# Ids: google, kiwi, skyscanner (opt-in), demo
# PROVIDERS=google,kiwi,skyscanner

# Kiwi (website API): one request per leg covers all airports and dates.
KIWI_MIN_DELAY_MS=24000
KIWI_DAILY_LIMIT=200
KIWI_COOLDOWN_MINUTES=180

# Google is fetched slowly and politely: one request at a time, 18–32 s apart,
# no retries, a 3 h pause on any block, and a daily cap.
GOOGLE_MIN_DELAY_MS=18400
GOOGLE_CONCURRENCY=1
GOOGLE_DAILY_LIMIT=300
GOOGLE_COOLDOWN_MINUTES=180

# Max live provider requests per search run, and how long answers are reused.
REQUEST_BUDGET=600
CACHE_TTL_MINUTES=300

# Synthetic demo prices (default: on only when no real provider is available).
# DEMO=1

# Behind an HTTP proxy (HTTPS_PROXY set)? Node's fetch needs this to use it (Node >= 22.21).
# NODE_USE_ENV_PROXY=1

# Browser window for Google Flights and Skyscanner: headed (visible, default), headless or off.
BROWSER=headed
# BROWSER_PROFILE_DIR=./.browser-profile
# How long to wait for you to do a robot check in the window.
HUMAN_WAIT_MINUTES=10
SKYSCANNER_MIN_DELAY_MS=36000
# Save Skyscanner's raw search data (to check/fix the reader on first use).
# SKYSCANNER_DEBUG=1
