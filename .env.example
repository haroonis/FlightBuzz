# Copy to .env (or export) to configure the server. All optional.

PORT=8787
HOST=127.0.0.1
# DB_PATH=./flightbuzz.db

# Refresh saved searches at these local times (in TZ).
SCHEDULE=07:00,19:00
TZ=Europe/London

# Providers to use. Empty = every configured one (Google via fast-flights-ts is on when installed).
# Ids: google, kiwi, demo
# PROVIDERS=google

# Kiwi partner key (free, but Kiwi only issues these to approved partners)
KIWI_TEQUILA_KEY=

# Google is fetched slowly and politely: one request at a time, 8–14 s apart,
# no retries, a 3 h pause on any block, and a daily cap.
GOOGLE_MIN_DELAY_MS=8000
GOOGLE_CONCURRENCY=1
GOOGLE_DAILY_LIMIT=1500
GOOGLE_COOLDOWN_MINUTES=180

# Max live provider requests per search run, and how long answers are reused.
REQUEST_BUDGET=600
CACHE_TTL_MINUTES=300

# Synthetic demo prices (default: on only when no real provider is available).
# DEMO=1

# Behind an HTTP proxy (HTTPS_PROXY set)? Node's fetch needs this to use it (Node >= 22.21).
# NODE_USE_ENV_PROXY=1
